# =====================
# Mutual Fund Chatbot - Example Configuration
# =====================
# Copy this file to .env and fill in your actual secrets/keys

# === LLM Providers ===
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=groq  # or openai or ollama
OLLAMA_MODEL=llama3
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate

# === Application ===
APP_NAME=Mutual Fund Chatbot
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development  # development, production, or testing
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# === Security ===
SECRET_KEY=your-very-long-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Database (PostgreSQL) ===
POSTGRES_HOST=34.57.196.130
POSTGRES_PORT=5432
POSTGRES_DB=mutualfundpro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mutual@fund@pro12
DATABASE_URL=postgresql://postgres:mutual@fund@pro12@34.57.196.130:5432/mutualfundpro

# === Redis (Caching/Sessions) ===
REDIS_URL=redis://localhost:6379/0

# === Vector Store ===
VECTOR_STORE_PATH=vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Web Search APIs ===
SERPAPI_API_KEY=your-serpapi-key-here
CONTEXTUALWEB_API_KEY=your-contextualweb-key-here
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=3

# === Monitoring & Logging ===
SENTRY_DSN=your-sentry-dsn-here
PROMETHEUS_ENABLED=True
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# === File Storage ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB

# === Cloud Integrations ===
GOOGLE_APPLICATION_CREDENTIALS_JSON=your-gcp-service-account-json-string

# === Grafana/Prometheus (Monitoring) ===
GRAFANA_PASSWORD=admin

# === Memory Optimization (for Render/Cloud) ===
TOKENIZERS_PARALLELISM=false
TRANSFORMERS_CACHE=/tmp/transformers_cache
HF_HOME=/tmp/huggingface

# === Other Integrations ===
# Add any other API keys, secrets, or service credentials here 